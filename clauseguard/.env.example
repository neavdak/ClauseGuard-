# Nebius Token Factory API Key (Required for live Nemotron inference)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model Overrides (Optional - defaults to auto-discovery from /v1/models)
NEMOTRON_NANO=
NEMOTRON_SUPER=
NEMOTRON_ULTRA=
NEMOTRON_VL=

# Tavily Search API Key (Recommended - enables live Indian legal precedent check)
TAVILY_API_KEY=your_tavily_api_key_here

# Request timeout in seconds
REQUEST_TIMEOUT=120

# Force offline mock mode (1 = enable heuristic offline engine, 0 or empty = live models)
MOCK_MODE=
